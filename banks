import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.server.ResponseStatusException;

import java.math.BigDecimal;
import java.util.Map;
import java.util.UUID;
import java.util.concurrent.ConcurrentHashMap;

@SpringBootApplication
@RestController
@RequestMapping("/api")
public class BankingApplication {

    private final Map<String, Account> accounts = new ConcurrentHashMap<>();

    public static void main(String[] args) {
        SpringApplication.run(BankingApplication.class, args);
    }

    @PostMapping("/accounts")
    public String createAccount(@RequestParam String name,
                                @RequestParam BigDecimal initialDeposit) {

        if (initialDeposit == null) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                    "Initial deposit is required.");
        }

        if (name == null || name.isBlank()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                    "Account holder name is required.");
        }

        if (initialDeposit.compareTo(BigDecimal.ZERO) < 0) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                    "Initial deposit cannot be negative.");
        }

        String accountNumber = UUID.randomUUID()
                .toString()
                .replace("-", "")
                .substring(0, 10)
                .toUpperCase();

        Account account = new Account(
                accountNumber,
                name,
                initialDeposit
        );

        accounts.put(accountNumber, account);

        return "Account created successfully.\n"
                + "Account Number: " + accountNumber
                + "\nAccount Holder: " + name
                + "\nBalance: " + initialDeposit;
    }
    
    @PostMapping("/accounts/{accountNumber}/deposit")
    public String deposit(@PathVariable String accountNumber,
                          @RequestParam BigDecimal amount) {

        Account account = accounts.get(accountNumber);

        if (account == null) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Account not found.");
        }

        if (amount == null || amount.compareTo(BigDecimal.ZERO) <= 0) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                    "Deposit amount must be greater than zero.");
        }

        synchronized (account) {
            account.balance = account.balance.add(amount);
        }

        return "Deposit successful.\n"
                + "Account Number: " + accountNumber
                + "\nDeposited: " + amount
                + "\nNew Balance: " + account.balance;
    }
    
    @PostMapping("/accounts/{accountNumber}/withdraw")
    public String withdraw(@PathVariable String accountNumber,
                           @RequestParam BigDecimal amount) {

        Account account = accounts.get(accountNumber);

        if (account == null) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Account not found.");
        }

        if (amount == null || amount.compareTo(BigDecimal.ZERO) <= 0) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                    "Withdrawal amount must be greater than zero.");
        }

        BigDecimal newBalance;

        synchronized (account) {
            if (account.balance.compareTo(amount) < 0) {
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                        "Insufficient balance.");
            }

            account.balance = account.balance.subtract(amount);
            newBalance = account.balance;
        }

        return "Withdrawal successful.\n"
                + "Account Number: " + accountNumber
                + "\nWithdrawn: " + amount
                + "\nNew Balance: " + newBalance;
    }

    @GetMapping("/accounts/{accountNumber}/balance")
    public String getBalance(@PathVariable String accountNumber) {

        Account account = accounts.get(accountNumber);

        if (account == null) {
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Account not found.");
        }

        return "Account Number: " + account.accountNumber
                + "\nAccount Holder: " + account.name
                + "\nCurrent Balance: " + account.balance;
    }

    static class Account {

        String accountNumber;
        String name;
        BigDecimal balance;

        Account(String accountNumber, String name, BigDecimal balance) {
            this.accountNumber = accountNumber;
            this.name = name;
            this.balance = balance;
        }
    }
}
